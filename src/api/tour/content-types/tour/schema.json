{
  "kind": "collectionType",
  "collectionName": "tours",
  "info": {
    "singularName": "tour",
    "pluralName": "tours",
    "displayName": "Tour"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "durationDays": {
      "type": "integer"
    },
    "priceFrom": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "difficulty": {
      "type": "enumeration",
      "enum": [
        "easy",
        "moderate",
        "challenging",
        "extreme"
      ]
    },
    "groupSizeMin": {
      "type": "integer"
    },
    "groupSizeMax": {
      "type": "integer"
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "tour.list-item"
    },
    "inclusions": {
      "type": "component",
      "repeatable": true,
      "component": "tour.list-item"
    },
    "exclusions": {
      "type": "component",
      "repeatable": true,
      "component": "tour.list-item"
    },
    "itinerary": {
      "type": "component",
      "repeatable": true,
      "component": "tour.itinerary-day"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "destination": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destination.destination",
      "inversedBy": "tours"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "tours"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
